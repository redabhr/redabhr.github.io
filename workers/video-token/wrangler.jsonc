{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reda-background-video-token",
  "main": "src/index.js",
  "compatibility_date": "2026-08-23",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://reda.bouhaddar.com",
    "MUX_PLAYBACK_ID_LANDSCAPE": "vv02Pg01GrrucgresYJHeWkaAALyN2H02yYS6fo019FaT8I",
    "MUX_PLAYBACK_ID_PORTRAIT": "Y01lQB2bD5Lct12pSMe02H02Ve9O67VjrE1N027r01o8fcQI",
    "MUX_PLAYBACK_RESTRICTION_ID": "024TsaqNaYo2ffgc15YFxy7d6K01i5Cr9qbOtJrCeAGTA",
    "MAX_LANDSCAPE_RESOLUTION": "2160p",
    "MAX_PORTRAIT_RESOLUTION": "720p",
    "TOKEN_TTL_SECONDS": "60"
  },
  "ratelimits": [
    {
      "name": "VIDEO_TOKEN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}
